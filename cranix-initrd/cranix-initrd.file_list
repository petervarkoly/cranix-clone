# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#
# cranix itool extra packages
#
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
coreutils:
    /usr/bin/base64
    /usr/bin/basename
    /usr/bin/chroot
    /usr/bin/cp
    /usr/bin/date
    /usr/bin/dd
    /usr/bin/df
    /usr/bin/ls
    /usr/bin/mkdir
    /usr/bin/rm
    /usr/bin/touch
    /usr/bin/tr

dialog:
    /etc/dialogrc
    /usr/bin/dialog
    /usr/share/locale/de/LC_MESSAGES/dialog.mo

dd_rescue:

gawk:
   /usr/bin/gawk

grep:
   /bin/grep

gptfdisk:
   /usr/sbin/sgdisk
   /usr/sbin/gdisk

joe:
   /usr/bin/joe

libext2fs2:

ntfsprogs:

parted:

partclone:

rsync:

openssh:
 /usr/sbin/sshd
 /usr/bin/ssh-keygen

udpcast:

util-linux:
  /sbin/fdisk
  /usr/sbin/sfdisk
  /usr/sbin/fdisk

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#
# cranix extra scripts and config files
#
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

e mkdir -p -m 700 root/.ssh/
e mkdir -p usr/share/YaST2/lib/y2system_role_handlers/
e mkdir -p usr/lib/rpm/gnupg/keys/
x bin/*                     bin/
x root/*                    root/
x etc/ssh/sshd_config       etc/ssh/sshd_config
x root/.ssh/authorized_keys root/.ssh/authorized_keys
x usr/share/YaST2/lib/y2system_role_handlers/cranix_role_finish.rb usr/share/YaST2/lib/y2system_role_handlers/cranix_role_finish.rb
x usr/lib/rpm/gnupg/keys/gpg-pubkey-45de42b0-553d9175.asc.key usr/lib/rpm/gnupg/keys/gpg-pubkey-45de42b0-553d9175.asc.key
